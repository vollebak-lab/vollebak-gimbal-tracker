[Unit]
Description=Vollebak fixed-camera gimbal tracker
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=vollebak
WorkingDirectory=/home/vollebak/vollebak-gimbal-tracker
ExecStart=/home/vollebak/vollebak-gimbal-tracker/.venv/bin/gimbal-tracker ui -c config/pi.yaml --host 0.0.0.0 --port 8080
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
